rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Purchase records are written only by the Lemon Squeezy webhook, which
    // uses the Admin SDK and bypasses these rules. Clients may read their own
    // record and nothing else.
    match /purchases/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
